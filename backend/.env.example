PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/postbot
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:5173

# LinkedIn OAuth App Credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/linkedin/callback
LINKEDIN_VERSION=202501

# Token Encryption (AES-256-GCM - 32-byte hex or secret string)
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_32_bytes_or_passphrase_here

# LLM Text Generation (Google Gemini API / OpenAI / Anthropic)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Optional alternatives:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Image Generation (Pollinations.ai / Stability AI)
IMAGE_PROVIDER=pollinations
# STABILITY_API_KEY=your_stability_api_key_here

# Cloudinary Image Hosting
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
# Or CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Redis & BullMQ Queue Configuration
REDIS_URL=redis://localhost:6379
# For Upstash Redis over TLS:
# REDIS_URL=rediss://default:your_upstash_password@your_endpoint.upstash.io:6379

# Email Notifications (Resend / SendGrid)
# Provider auto-detects if RESEND_API_KEY or SENDGRID_API_KEY is provided
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
EMAIL_FROM=PostBot <onboarding@resend.dev>
TEST_EMAIL_RECIPIENT=your_test_email@example.com

