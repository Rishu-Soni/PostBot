# MongoDB connection URI (must be a replica set — required for credit/regen multi-document transactions)
MONGO_URI=mongodb://127.0.0.1:27017/postbot?replicaSet=rs0

# JWT secret key used to sign and verify user authentication tokens
JWT_SECRET=your-jwt-secret-key-here

# JWT token expiration duration
JWT_EXPIRES_IN=7d

# Secret API key required to access internal administrator routes (x-admin-key header)
ADMIN_KEY=your-admin-secret-key-here

# Client frontend URL for CORS policy
CLIENT_URL=http://localhost:5173

# Port on which the backend Express server listens
PORT=5000

# LinkedIn App Client ID from developer portal (Share on LinkedIn product)
LINKEDIN_CLIENT_ID=

# LinkedIn App Client Secret from developer portal
LINKEDIN_CLIENT_SECRET=

# Authorized OAuth redirect callback URL configured in LinkedIn developer portal
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/v1/linkedin/callback

# Optional dedicated secret used to sign tamper-evident LinkedIn OAuth state tokens (defaults to JWT_SECRET if unset)
LINKEDIN_STATE_SECRET=

# LLM provider (for elaboration, caption/hashtag generation)
AI_PROVIDER_API_KEY=

# Stock image APIs
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# AI image generation — platform default, used when user hasn't supplied their own key
DEFAULT_IMAGE_GEN_API_KEY=

# Persistent image storage for user uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App
NODE_ENV=development

# Scheduler
SCHEDULER_CRON_EXPRESSION=*/5 * * * *

# Email provider
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

